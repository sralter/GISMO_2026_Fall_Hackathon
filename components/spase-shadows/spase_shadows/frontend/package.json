{
  "name": "spase_shadows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:frontend:production",
    "build:frontend:production": "cross-env NODE_ENV=production vite build",
    "clean": "rimraf build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "format": "prettier --write src/**/*.ts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "prettier": {},
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/json": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@streamlit/component-v2-lib": "^0.2.0"
  },
  "overrides": {
    "@luma.gl/constants": "9.4.2",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/gpgpu": "9.4.2",
    "@luma.gl/shadertools": "9.4.2",
    "@luma.gl/webgl": "9.4.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
